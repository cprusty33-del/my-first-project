{
  "name": "mcl-audit-report-builder",
  "version": "1.0.0",
  "description": "MCL Internal Audit Report Builder - desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./build/output.css --minify",
    "build:js": "esbuild src/index.jsx --bundle --outfile=build/bundle.js --loader:.jsx=jsx",
    "build": "npm run build:css && npm run build:js",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.23.0",
    "tailwindcss": "^3.4.10"
  },
  "build": {
    "appId": "com.ckprusty.mclauditreportbuilder",
    "productName": "MCL Audit Report Builder",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    }
  }
}
