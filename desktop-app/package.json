{
  "name": "mcl-audit-report-builder",
  "version": "1.0.0",
  "description": "MCL Internal Audit Report Builder - desktop app",
  "main": "build/main.js",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./build/output.css --minify",
    "build:js": "esbuild src/index.jsx --bundle --outfile=build/bundle.js --loader:.jsx=jsx",
    "build:main": "esbuild src/main.js --bundle --platform=node --target=node18 --external:electron --outfile=build/main.js",
    "build:preload": "esbuild src/preload.js --bundle --platform=node --target=node18 --external:electron --outfile=build/preload.js",
    "build": "npm run build:css && npm run build:js && npm run build:main && npm run build:preload",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.23.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.ckprusty.mclauditreportbuilder",
    "productName": "MCL Audit Report Builder",
    "files": [
      "index.html",
      "build/**/*",
      "assets/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
