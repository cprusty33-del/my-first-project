{
  "baseUrl": "https://www.incometaxlibrary.com",
  "auth": {
    "mode": "cookie",
    "cookieEnv": "ITL_COOKIE",
    "loginPath": null,
    "loginMethod": "POST",
    "loginFields": { "username": "", "password": "" },
    "userEnv": "ITL_USER",
    "passEnv": "ITL_PASS"
  },
  "timeoutMs": 45000,
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) itl-mcp/0.1",
  "workspace": "./itl-workspace",
  "endpoints": {
    "search": null,
    "recent": null,
    "document": null
  },
  "notes": "Endpoints are intentionally null. Fill them in from the site's own network calls (DevTools > Network) or by using the itl_probe tool. See README.md > Discovering endpoints."
}
